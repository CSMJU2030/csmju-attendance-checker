# ---------------------------------------------------------------------------
# ค่าที่ docker compose อ่าน (คัดลอกเป็น .env ข้าง docker-compose.yml - ห้าม commit .env)
# การรันในเครื่องแบบไม่ใช้ Docker ใช้ backend/.env.example และ frontend/.env.example แทน
# ขั้นตอนขึ้นเซิร์ฟเวอร์จริงทั้งหมดอยู่ใน docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------

# development = ในเครื่อง · production = เซิร์ฟเวอร์จริงหลัง https
# (production ทำให้คุกกี้เข้าสู่ระบบเป็น Secure และบังคับตั้งค่า Core Hub ให้ครบ)
NODE_ENV=development

# รหัสผ่านฐานข้อมูลของระบบนี้ - บนเซิร์ฟเวอร์จริงต้องเปลี่ยนเป็นรหัสยาวที่สุ่มขึ้นมา
POSTGRES_PASSWORD=postgres

# Core Hub จริง (ค่าเริ่มต้นของ docker-compose.yml ชี้ที่นี่อยู่แล้ว)
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# สัญญาที่ตรึงไว้ - ห้ามเปลี่ยนเอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
