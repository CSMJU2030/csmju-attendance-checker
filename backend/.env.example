# ---------------------------------------------------------------------------
# Attendance Checker backend - example environment
# Copy to backend/.env BEFORE `pnpm install`. NEVER commit .env.
# Connecting to the real Core Hub step by step: standards/docs/connect-core-hub.md
# ---------------------------------------------------------------------------

NODE_ENV=development

# Backend port 42xx; its frontend pair uses 32xx and is the registered callback port.
# Assigned by the dev-server admin: backend 4202, frontend 5001 (the PM's port list).
PORT=4202

# This subsystem owns its OWN database. It must NOT point at the Core Hub DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_checker_db
# Connection pool size. The server shares one PostgreSQL between all subsystems (deployment.md 4.1).
DATABASE_POOL_MAX=5

# Core Hub (identity provider) - the real server. Local Core Hub: http://localhost:3000
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
# Core Hub's web app: GET /auth/login sends the browser to /sso/authorize there,
# POST /auth/logout to /logout. Local Core Hub: http://localhost:3100
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# Immutable Core Hub JWT contract
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# Subsystem identity - must match `name` in the Subsystem Registry and subsystem.yaml
SUBSYSTEM_ID=csmju-attendance-checker
SUBSYSTEM_NAME=Attendance Checker

# JWKS cache behaviour (milliseconds)
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000

# Core Hub data calls (GET /people/me at check-in; reference data if ever used)
CORE_HUB_DATA_CACHE_TTL_MS=600000
CORE_HUB_DATA_MIN_REFRESH_INTERVAL_MS=30000
CORE_HUB_DATA_REQUEST_TIMEOUT_MS=5000

# Clock skew tolerance when validating exp/iat (seconds)
JWT_CLOCK_TOLERANCE_SEC=5
