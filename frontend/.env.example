# ---------------------------------------------------------------------------
# Attendance Checker frontend - example environment
# Copy to frontend/.env.local and adjust. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# NestJS backend of this subsystem (42xx). Server-side only: used by the
# /api/* and /auth/* rewrites and by server components. Never reaches the browser.
# TODO: replace 3002 with the team's 42xx backend port.
BACKEND_URL=http://127.0.0.1:3002

# Core Hub's web app - the "back to dashboard" link. Public: a plain URL, never a secret.
# Local Core Hub: http://localhost:3100
NEXT_PUBLIC_CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# Must match `name` in subsystem.yaml and the Core Hub Subsystem Registry.
# The session cookie is named after it: csmju_attendance_checker_access_token
NEXT_PUBLIC_SUBSYSTEM_NAME=csmju-attendance-checker
