# ---------------------------------------------------------------------------
# Attendance Checker frontend - example environment
# Copy to .env.local and adjust. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# NestJS backend of this subsystem. Server-side only: used by the /api rewrite,
# server components and the SSO callback route. Never exposed to the browser.
BACKEND_URL=http://localhost:3002

# Core Hub portal (frontend). Public: the "sign in" button and "back to
# dashboard" link point here. It is a plain URL, never a secret.
NEXT_PUBLIC_CORE_HUB_PORTAL_URL=http://localhost:3100

# Must match `name` in subsystem.yaml and the Core Hub Subsystem Registry.
NEXT_PUBLIC_SUBSYSTEM_NAME=csmju-attendance-checker
